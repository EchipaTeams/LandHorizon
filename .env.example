# Copy to .env (gitignored) and fill in. Only placeholders here: never commit a real address or secret.

# Where the site answers. Locally ":80" (plain HTTP on http://localhost). On the server: the domain only,
# e.g. landhorizon.example; Caddy then gets the HTTPS certificate itself (ports 80 and 443 must be open).
SITE_ADDRESS=:80

# The folder that holds hand.tif, ground.tif, worldcover.tif and the flood file.
DATA_DIR=./data/processed
# The flood file's name inside DATA_DIR (the 10-year history, 2015 – 13 Apr 2025).
FLOOD_FILE=flood_gfm.tif

# The website's build output (npm run build in the website repo).
WEB_DIST=./dist

# Host ports, if 80 or 443 are taken on this machine.
HTTP_PORT=80
HTTPS_PORT=443
